<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".YambolApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yambol"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Yambol">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FirebaseUI Activities with AppCompat theme -->
        <activity
            android:name="com.firebase.ui.auth.ui.idp.AuthMethodPickerActivity"
            android:theme="@style/FirebaseUITheme"
            tools:replace="android:theme" />

        <activity
            android:name="com.firebase.ui.auth.ui.email.EmailActivity"
            android:theme="@style/FirebaseUITheme"
            tools:replace="android:theme" />

        <activity
            android:name="com.firebase.ui.auth.ui.phone.PhoneActivity"
            android:theme="@style/FirebaseUITheme"
            tools:replace="android:theme" />

        <activity
            android:name="com.firebase.ui.auth.ui.idp.SingleSignInActivity"
            android:theme="@style/FirebaseUITheme"
            tools:replace="android:theme" />

    </application>

</manifest>