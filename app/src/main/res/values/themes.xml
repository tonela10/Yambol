<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Yambol" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="FirebaseUITheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Map Material3 colors to AppCompat colors -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryDark">@color/md_theme_primaryContainer</item>
        <item name="colorAccent">@color/md_theme_secondary</item>

        <!-- Optional: Customize FirebaseUI appearance -->
        <item name="colorButtonNormal">@color/md_theme_primary</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>
    </style>
</resources>